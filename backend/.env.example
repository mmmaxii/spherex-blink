# Copy to backend/.env to change settings locally. On Render, set the same names as environment
# variables. Every setting in app/config.py can be overridden as SPHEREX_<NAME IN CAPITALS>.

# A new SPHEREx release: add its SIA collection here (JSON list).
# SPHEREX_SIA_COLLECTIONS=["spherex_dr1","spherex_qr3"]

# Sites allowed to call the API directly (the Vercel site calls it through a rewrite).
# SPHEREX_ALLOWED_ORIGINS=["http://localhost:5173","https://spherex-blink-umber.vercel.app"]

# Work done at the same time on the single instance.
# SPHEREX_MAX_CONCURRENT_JOBS=2
# SPHEREX_MAX_PARALLEL_S3=12

# Images read per request (more = better stacks, slower).
# SPHEREX_DEFAULT_MAX_FRAMES=24

# SPHEREX_LOG_LEVEL=INFO
